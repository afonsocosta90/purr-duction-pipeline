.git/
.dvc/
.venv/
__pycache__/
*.pyc
*.pyo
.ruff_cache/
.mypy_cache/
.pytest_cache/
htmlcov/
.coverage

# Notebooks (outputs can be large)
notebooks/

# Local secrets / IDE
.env
.vscode/
.idea/
