# Heavy data directories — never needed inside the image at build time.
# The API reads these from the bind-mounted host volume at runtime.
data/
mlruns/
mlflow.db
outputs/
artifacts/
models/
dvc-remote-storage/

# DVC pipeline files — irrelevant for inference/serving
dvc.yaml
dvc.lock
.dvcignore

# Dev/tooling noise
.git/
.dvc/
.venv/
__pycache__/
*.pyc
*.pyo
.ruff_cache/
.mypy_cache/
.pytest_cache/
htmlcov/
.coverage

# Notebooks, demo, docs, tests — not needed in production image
notebooks/
demo/
docs/
tests/
pipelines/
monitoring/

# Tooling / project docs
Makefile
*.md

# Local secrets / IDE
.env
.vscode/
.idea/
