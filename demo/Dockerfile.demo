# demo/Dockerfile.demo
# Extends the production API image — reuses ALL ML dependencies already built
# in the API image (PyTorch, torchvision, FastAPI, DVC, Poetry venv, etc.).
# Only adds the 3 demo-specific packages: streamlit, httpx, plotly.
#
# Build time: ~30 s (vs ~10 min rebuilding from scratch).
#
# The base image is selected via the BASE_IMAGE build-arg (see ARG below):
#   - Local (demo/launch.py / `make demo`): defaults to `catops-api:demo`,
#     the tag the launcher creates — that base must be built/pulled first.
#   - CI/CD: the docker workflow passes the freshly built-and-pushed GHCR
#     image, so the demo image always layers on the current API image.

ARG BASE_IMAGE=catops-api:demo
FROM ${BASE_IMAGE}

# Switch to root briefly to install demo group packages via Poetry
# (versions are governed by poetry.lock — no manual pip pins needed)
USER root

RUN poetry install --with demo --no-root --no-interaction

# Drop back to the non-root user defined in the base image
USER appuser

EXPOSE 8501

ENV STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
ENV STREAMLIT_SERVER_HEADLESS=true

CMD ["streamlit", "run", "demo/streamlit_app.py", \
     "--server.port=8501", \
     "--server.address=0.0.0.0", \
     "--server.enableCORS=false", \
     "--server.enableXsrfProtection=false"]
