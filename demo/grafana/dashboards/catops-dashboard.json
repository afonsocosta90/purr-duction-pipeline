{
  "__inputs": [],
  "__requires": [
    {"type": "grafana",    "id": "grafana",    "name": "Grafana",    "version": "10.0.0"},
    {"type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0"},
    {"type": "panel",      "id": "gauge",      "name": "Gauge",      "version": ""},
    {"type": "panel",      "id": "stat",       "name": "Stat",       "version": ""},
    {"type": "panel",      "id": "timeseries", "name": "Time series","version": ""},
    {"type": "panel",      "id": "barchart",   "name": "Bar chart",  "version": ""},
    {"type": "panel",      "id": "histogram",  "name": "Histogram",  "version": ""}
  ],
  "annotations": {"list": []},
  "description": "Am I a Cat? — live inference metrics, confidence distribution, and label breakdown",
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [

    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "id": 100,
      "title": "Overview",
      "type": "row"
    },

    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [],
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green", "value": null}
          ]},
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 1},
      "id": 1,
      "options": {"colorMode": "background", "graphMode": "area", "justifyMode": "center",
                  "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"]},
                  "text": {}, "textMode": "auto"},
      "pluginVersion": "10.4.2",
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
        "expr": "sum(catops_predictions_total)",
        "legendFormat": "Total predictions",
        "refId": "A"
      }],
      "title": "Total Predictions",
      "type": "stat"
    },

    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [],
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green", "value": null}
          ]},
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 1},
      "id": 2,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "center",
                  "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"]},
                  "text": {}, "textMode": "auto"},
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
        "expr": "catops_predictions_total{label=\"cat\"}",
        "legendFormat": "Cat predictions",
        "refId": "A"
      }],
      "title": "🐱 Cat Predictions",
      "type": "stat"
    },

    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [],
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "red", "value": null}
          ]},
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 4, "x": 8, "y": 1},
      "id": 3,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "center",
                  "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"]},
                  "text": {}, "textMode": "auto"},
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
        "expr": "catops_predictions_total{label=\"not_cat\"}",
        "legendFormat": "Not-Cat predictions",
        "refId": "A"
      }],
      "title": "🚫 Not-Cat Predictions",
      "type": "stat"
    },

    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [],
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "red",    "value": null},
            {"color": "yellow", "value": 0.015},
            {"color": "green",  "value": 0.05}
          ]},
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 4, "x": 12, "y": 1},
      "id": 4,
      "options": {"colorMode": "background", "graphMode": "area", "justifyMode": "center",
                  "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"]},
                  "text": {}, "textMode": "auto"},
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
        "expr": "rate(http_requests_total{handler=\"/predict\"}[5m])",
        "legendFormat": "Predict req/s",
        "refId": "A"
      }],
      "title": "Prediction Rate",
      "type": "stat"
    },

    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "max": 1,
          "min": 0,
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "red",    "value": null},
            {"color": "yellow", "value": 0.7},
            {"color": "green",  "value": 0.85}
          ]},
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 4, "x": 16, "y": 1},
      "id": 5,
      "options": {"orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"]},
                  "showThresholdLabels": false, "showThresholdMarkers": true},
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
        "expr": "catops_prediction_confidence_sum / catops_prediction_confidence_count",
        "legendFormat": "Avg confidence",
        "refId": "A"
      }],
      "title": "Avg Confidence",
      "type": "gauge"
    },

    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [],
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green", "value": null},
            {"color": "yellow", "value": 100},
            {"color": "red",    "value": 500}
          ]},
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 4, "x": 20, "y": 1},
      "id": 6,
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "center",
                  "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"]},
                  "text": {}, "textMode": "auto"},
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
        "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket{handler=\"/predict\"}[5m])) * 1000",
        "legendFormat": "p95 latency",
        "refId": "A"
      }],
      "title": "p95 Latency",
      "type": "stat"
    },

    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 5},
      "id": 101,
      "title": "Time Series",
      "type": "row"
    },

    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"lineWidth": 2, "fillOpacity": 10, "showPoints": "never"},
          "unit": "short"
        },
        "overrides": [
          {"matcher": {"id": "byName", "options": "cat"},
           "properties": [{"id": "color", "value": {"fixedColor": "#4CAF50", "mode": "fixed"}}]},
          {"matcher": {"id": "byName", "options": "not_cat"},
           "properties": [{"id": "color", "value": {"fixedColor": "#F44336", "mode": "fixed"}}]}
        ]
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6},
      "id": 10,
      "options": {"legend": {"displayMode": "list", "placement": "bottom"},
                  "tooltip": {"mode": "multi"}},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "increase(catops_predictions_total{label=\"cat\"}[1m])",
          "legendFormat": "cat",
          "refId": "A"
        },
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "increase(catops_predictions_total{label=\"not_cat\"}[1m])",
          "legendFormat": "not_cat",
          "refId": "B"
        }
      ],
      "title": "Prediction Volume by Label (per minute)",
      "type": "timeseries"
    },

    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"lineWidth": 2, "fillOpacity": 15, "showPoints": "never"},
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6},
      "id": 11,
      "options": {"legend": {"displayMode": "list", "placement": "bottom"},
                  "tooltip": {"mode": "single"}},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "catops_prediction_confidence_sum / catops_prediction_confidence_count",
          "legendFormat": "Average confidence",
          "refId": "A"
        },
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "histogram_quantile(0.10, rate(catops_prediction_confidence_bucket[5m]))",
          "legendFormat": "p10 confidence",
          "refId": "B"
        }
      ],
      "title": "Model Confidence Over Time",
      "type": "timeseries"
    },

    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"lineWidth": 1, "fillOpacity": 5, "showPoints": "never"},
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 14},
      "id": 12,
      "options": {"legend": {"displayMode": "list", "placement": "bottom"},
                  "tooltip": {"mode": "multi"}},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "histogram_quantile(0.50, rate(http_request_duration_seconds_bucket{handler=\"/predict\"}[5m]))",
          "legendFormat": "p50 latency",
          "refId": "A"
        },
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket{handler=\"/predict\"}[5m]))",
          "legendFormat": "p95 latency",
          "refId": "B"
        },
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket{handler=\"/predict\"}[5m]))",
          "legendFormat": "p99 latency",
          "refId": "C"
        }
      ],
      "title": "Request Latency Percentiles — /predict",
      "type": "timeseries"
    },

    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 22},
      "id": 102,
      "title": "Distributions",
      "type": "row"
    },

    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "fixed", "fixedColor": "blue"},
          "custom": {},
          "unit": "short"
        },
        "overrides": [
          {"matcher": {"id": "byName", "options": "cat"},
           "properties": [{"id": "color", "value": {"fixedColor": "#4CAF50", "mode": "fixed"}}]},
          {"matcher": {"id": "byName", "options": "not_cat"},
           "properties": [{"id": "color", "value": {"fixedColor": "#F44336", "mode": "fixed"}}]}
        ]
      },
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 23},
      "id": 20,
      "options": {
        "barRadius": 0.05,
        "barWidth": 0.6,
        "groupWidth": 0.7,
        "legend": {"displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "single"},
        "xTickLabelRotation": 0,
        "xTickLabelSpacing": 100
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "catops_predictions_total",
          "legendFormat": "{{label}}",
          "refId": "A",
          "instant": true
        }
      ],
      "title": "Prediction Label Distribution",
      "type": "barchart"
    },

    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"fillOpacity": 80, "gradientMode": "none", "hideFrom": {"legend": false, "tooltip": false, "viz": false}, "lineWidth": 1},
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 16, "x": 8, "y": 23},
      "id": 21,
      "options": {
        "bucketSize": "auto",
        "combine": false,
        "fillOpacity": 80,
        "gradientMode": "none",
        "legend": {"displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "single"}
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "catops_prediction_confidence_bucket",
          "legendFormat": "Confidence bucket {{le}}",
          "refId": "A",
          "instant": true
        }
      ],
      "title": "Confidence Score Distribution",
      "type": "histogram"
    }

  ],

  "refresh": "15s",
  "schemaVersion": 39,
  "tags": ["catops", "mlops", "demo"],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "name": "DS_PROMETHEUS",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "type": "datasource"
      }
    ]
  },
  "time": {"from": "now-30m", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "CatOps — Am I a Cat? Live Metrics",
  "uid": "catops-v1",
  "version": 1
}
